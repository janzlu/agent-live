# ==============================================================================
# Agent Live 配置文件模板
# 使用方法: 复制此文件为 .env 并填入您的配置
# cp .env.example .env
# ==============================================================================

# 1. Google Gemini API 密钥 (必填)
# 从 Google AI Studio 免费获取: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# 2. 实时语音多模态模型 (默认 Gemini 3.8 Live)
LIVE_MODEL_NAME=models/gemini-3.8-live

# 3. 语音合成音色 (可选: Puck, Charon, Kore, Fenrir, Aoede)
VOICE_NAME=Puck

# 4. 绑定的工程工作区根路径 (默认为当前目录)
WORKSPACE_PATH=.

# 5. 代码与工程执行引擎 (可选: direct / cli，默认 direct 内置直连引擎)
EXECUTION_ENGINE=direct

# 6. 网络代理设置 (若国内网络直连受限，填入本地代理端口，如 Clash: 127.0.0.1:7897)
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
